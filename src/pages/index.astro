---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import ArtworkLightbox from '../components/ArtworkLightbox.astro';
import ProgramCard from '../components/ProgramCard.astro';
import TuitionCards from '../components/TuitionCards.astro';
import { getArtwork, getPrograms, getSiteSettings, getPrimaryTuition } from '../lib/content';

const [allArtwork, programs, settings, tuition] = await Promise.all([
  getArtwork(),
  getPrograms(),
  getSiteSettings(),
  getPrimaryTuition(),
]);
// Homepage gallery is automatic: show the six most recent public works.
const artwork = allArtwork.slice(0, 6);
const backgroundFallback = allArtwork.slice(0, 3);
const leadFallback = allArtwork.slice(0, 3);
const heroPoolJson = JSON.stringify(allArtwork.map((item) => ({
  image: item.imageLarge || item.image,
  alt: item.alt || `${item.title} by ${item.student}`,
}))).replace(/</g, '\\u003c');
const primaryProgram = programs.find((program) => program.primaryProgram) || programs[0];
const secondaryPrograms = programs.filter((program) => program.id !== primaryProgram?.id);
---
<BaseLayout>
  <section class:list={["home-hero-shell", settings.homepageVideoUrl && "has-home-video"]}>
    {backgroundFallback[0] && (
      <img
        class="home-section-backdrop home-hero-art"
        data-home-backdrop="hero"
        src={backgroundFallback[0].imageLarge || backgroundFallback[0].image}
        alt=""
        aria-hidden="true"
      />
    )}
    {settings.homepageVideoPosterUrl && (
      <div
        class="home-hero-poster"
        style={`background-image:url(${settings.homepageVideoPosterUrl})`}
        aria-hidden="true"
      ></div>
    )}
    {settings.homepageVideoUrl && (
      <video
        class="home-hero-video"
        data-home-video
        data-src={settings.homepageVideoUrl}
        poster={settings.homepageVideoPosterUrl}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
      ></video>
    )}
    <div class="home-media-shade home-hero-shade" aria-hidden="true"></div>

    <div class="section-pad home-intro">
      <div class="home-intro-copy home-content-panel">
        <h1>Liang Art Studio</h1>
        <p class="home-tagline">{settings.tagline}</p>
        <div class="button-row">
          <a class="button primary" href="/gallery">Student Gallery</a>
          <a class="button secondary" href="/tuition">Tuition Rates</a>
        </div>
      </div>
      {leadFallback.length > 0 && (
        <div class="home-lead-grid" aria-label="Student artwork spotlight">
          {leadFallback.map((item, index) => (
            <a class={`home-lead-art home-lead-art-${index + 1}`} href="/gallery" aria-label="View student gallery">
              <img data-home-lead-art src={item.imageLarge || item.image} alt={item.alt || `${item.title} by ${item.student}`} />
            </a>
          ))}
        </div>
      )}
    </div>
    <script is:inline id="home-art-pool" type="application/json" set:html={heroPoolJson}></script>
  </section>

  <section class="section-pad gallery-feature home-gallery-section">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Gallery</p>
        <h2>Student Gallery</h2>
        <p>{settings.galleryIntro}</p>
      </div>
      <a class="text-link" href="/gallery">View full gallery <span>↗</span></a>
    </div>
    <div class="masonry-grid featured-grid">
      {artwork.map((item) => <ArtworkCard artwork={item} lightbox={true} />)}
    </div>
  </section>

  <section class="home-backdrop-section programs-preview">
    {backgroundFallback[1] && (
      <img
        class="home-section-backdrop"
        data-home-backdrop="programs"
        src={backgroundFallback[1].imageLarge || backgroundFallback[1].image}
        alt=""
        aria-hidden="true"
      />
    )}
    <div class="home-media-shade" aria-hidden="true"></div>
    <div class="section-pad">
      <div class="home-content-panel home-section-panel">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Classes</p><h2>Programs</h2></div>
          <a class="text-link" href="/programs">View programs <span>↗</span></a>
        </div>
        <div class="program-grid">
          {primaryProgram && <ProgramCard program={primaryProgram} prominent={true} />}
          {secondaryPrograms.map((program) => <ProgramCard program={program} />)}
        </div>
      </div>
    </div>
  </section>

  <ArtworkLightbox />

  <script>
    const poolNode = document.querySelector('#home-art-pool');
    const backdropImages = [...document.querySelectorAll('[data-home-backdrop]')];
    const leadImages = [...document.querySelectorAll('[data-home-lead-art]')];

    if (poolNode && (backdropImages.length || leadImages.length)) {
      try {
        const pool = JSON.parse(poolNode.textContent || '[]');
        const shuffled = [...pool];
        for (let i = shuffled.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }

        leadImages.forEach((image, index) => {
          const item = shuffled[index];
          if (!item) return;
          image.setAttribute('src', item.image);
          image.setAttribute('alt', item.alt || 'Student artwork');
        });

        // Start section backgrounds after the lead selection when possible so the
        // sharp spotlight images and atmospheric backdrops are less repetitive.
        const backgroundPool = shuffled.length > leadImages.length
          ? shuffled.slice(leadImages.length)
          : shuffled;
        backdropImages.forEach((image, index) => {
          const item = backgroundPool[index % Math.max(backgroundPool.length, 1)];
          if (!item) return;
          image.setAttribute('src', item.image);
          image.setAttribute('alt', '');
        });
      } catch (error) {
        console.warn('Unable to rotate homepage artwork.', error);
      }
    }

    const homeVideo = document.querySelector('[data-home-video]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktopVideo = window.matchMedia('(min-width: 721px)');

    if (homeVideo instanceof HTMLVideoElement && !reduceMotion.matches && desktopVideo.matches) {
      const src = homeVideo.dataset.src;
      if (src) {
        homeVideo.src = src;
        homeVideo.load();
        homeVideo.play().catch(() => {
          // The artwork/poster fallback remains visible if autoplay is unavailable.
        });
      }
    }
  </script>

  <section class="home-backdrop-section tuition-section-home">
    {backgroundFallback[2] && (
      <img
        class="home-section-backdrop"
        data-home-backdrop="tuition"
        src={backgroundFallback[2].imageLarge || backgroundFallback[2].image}
        alt=""
        aria-hidden="true"
      />
    )}
    <div class="home-media-shade home-media-shade-soft" aria-hidden="true"></div>
    <div class="section-pad">
      <div class="home-content-panel home-section-panel">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">{tuition.program} · {tuition.term}</p>
            <h2>Tuition Rates</h2>
            {tuition.classCount && <p>All plans include {tuition.classCount} total classes for the semester.</p>}
          </div>
          <a class="text-link" href="/tuition">Full tuition details <span>↗</span></a>
        </div>
        <TuitionCards tuition={tuition} compact={true} />
      </div>
    </div>
  </section>
</BaseLayout>
